<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_marginEnd="15dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imagemCategoria"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_corner_image_background"
        android:clipToOutline="true"
        tools:srcCompat="@drawable/vidros" />

    <TextView
        android:id="@+id/textoCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/np_fonseca_primary"
        app:layout_constraintTop_toBottomOf="@+id/imagemCategoria"
        app:layout_constraintStart_toStartOf="@+id/imagemCategoria"
        app:layout_constraintEnd_toEndOf="@+id/imagemCategoria"
        android:textSize="15sp"
        tools:text="Orçamento" />
</LinearLayout>